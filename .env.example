# The secrets of polestar. Copy this file to .env and fill in the values there.
# Git ignores .env but keeps this file, so never write values here.
#
# `cf dev` reads .env, and `cf deploy --secrets-file .env` uploads it with the
# Worker. To replace a secret, edit .env and deploy again.
#
# ANALYTICS_API_TOKEN: a Cloudflare API token that only reads, owned by the account
# that polestar watches. It needs two permissions: Account Analytics Read and D1 Read.
# This link opens the token form of your account with both permissions selected:
# https://dash.cloudflare.com/?to=/:account/api-tokens&permissionGroupKeys=%5B%7B%22key%22%3A%22account_analytics%22%2C%22type%22%3A%22read%22%7D%2C%7B%22key%22%3A%22d1%22%2C%22type%22%3A%22read%22%7D%5D&name=polestar
ANALYTICS_API_TOKEN=
