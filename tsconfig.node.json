{
  // Files that run in Node.js: configuration, scripts, and tests.
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": [
    "cloudflare.config.ts",
    "polestar.config.ts",
    "polestar.config.example.ts",
    "vite.config.ts",
    "vitest.config.ts",
    "config",
    "test"
  ]
}
